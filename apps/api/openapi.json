{
  "openapi": "3.1.0",
  "info": {
    "title": "Fashion AI Local Web",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/status": {
      "get": {
        "summary": "Status",
        "operationId": "status_api_v1_system_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SystemStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session/bootstrap": {
      "post": {
        "summary": "Bootstrap",
        "operationId": "bootstrap_api_v1_session_bootstrap_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BootstrapIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/session": {
      "get": {
        "summary": "Current",
        "operationId": "current_api_v1_session_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SessionOut"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Revoke",
        "operationId": "revoke_api_v1_session_delete",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "BootstrapIn": {
        "properties": {
          "bootstrap_secret": {
            "type": "string",
            "maxLength": 128,
            "minLength": 43,
            "title": "Bootstrap Secret"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "bootstrap_secret"
        ],
        "title": "BootstrapIn"
      },
      "DatabaseStatus": {
        "properties": {
          "configured": {
            "type": "boolean",
            "title": "Configured"
          },
          "schema_status": {
            "type": "string",
            "const": "not_inspected",
            "title": "Schema Status",
            "default": "not_inspected"
          }
        },
        "type": "object",
        "required": [
          "configured"
        ],
        "title": "DatabaseStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Health": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "instance_id": {
            "type": "string",
            "title": "Instance Id"
          }
        },
        "type": "object",
        "required": [
          "instance_id"
        ],
        "title": "Health"
      },
      "SessionOut": {
        "properties": {
          "csrf_token": {
            "type": "string",
            "title": "Csrf Token"
          },
          "expires_at": {
            "type": "string",
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "csrf_token",
          "expires_at"
        ],
        "title": "SessionOut"
      },
      "SystemStatus": {
        "properties": {
          "api_version": {
            "type": "string",
            "const": "v1",
            "title": "Api Version",
            "default": "v1"
          },
          "local_only": {
            "type": "boolean",
            "const": true,
            "title": "Local Only",
            "default": true
          },
          "readiness": {
            "type": "string",
            "enum": [
              "ready",
              "degraded"
            ],
            "title": "Readiness"
          },
          "tools": {
            "$ref": "#/components/schemas/Tools"
          },
          "database": {
            "$ref": "#/components/schemas/DatabaseStatus"
          },
          "models": {
            "type": "string",
            "const": "not_inspected",
            "title": "Models",
            "default": "not_inspected"
          }
        },
        "type": "object",
        "required": [
          "readiness",
          "tools",
          "database"
        ],
        "title": "SystemStatus"
      },
      "Tools": {
        "properties": {
          "ffmpeg": {
            "type": "boolean",
            "title": "Ffmpeg"
          },
          "ffprobe": {
            "type": "boolean",
            "title": "Ffprobe"
          },
          "subtitles": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "not_inspected"
            ],
            "title": "Subtitles"
          }
        },
        "type": "object",
        "required": [
          "ffmpeg",
          "ffprobe",
          "subtitles"
        ],
        "title": "Tools"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
