APP_NAME=Fashion AI Localizer
APP_ENV=local
STORAGE_ROOT=./storage
DATABASE_URL=sqlite:///./storage/fashion_ai.db
MAX_UPLOAD_SIZE_MB=500
MAX_VIDEO_SECONDS=180
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
LOG_LEVEL=INFO

# M1: no model download or paid API is triggered by starting the app.
OCR_SAMPLE_INTERVAL_SECONDS=1.0
OCR_MAX_FRAMES=300
OCR_MAX_SIDE=1280
OCR_MAX_SOURCE_PIXELS=16777216
OCR_ENABLE_GPU=false
OCR_CPU_THREADS=2
OCR_MIN_CONFIDENCE=0.4
OCR_SIMILARITY_THRESHOLD=0.94
OCR_IOU_THRESHOLD=0.3
# Empty model dirs default to STORAGE_ROOT/models/paddle and /argos.
OCR_MODELS_DIR=
ARGOS_MODELS_DIR=
TRANSLATION_PROVIDER=manual
TRANSLATION_TIMEOUT_SECONDS=60
TRANSLATION_RETRIES=2
TRANSLATION_MAX_CHARACTERS=10000
JOB_TIMEOUT_SECONDS=1800

# M2: sequential CPU render; no model download.
RENDER_TIMEOUT_SECONDS=1800
RENDER_MAX_FRAMES=12000
RENDER_MAX_FPS=60
PREVIEW_CACHE_ENTRIES=12

# M3: no startup model downloads; all paths are local.
ASR_PROVIDER=funasr
ASR_MODEL_DIR=./storage/models/funasr
WHISPER_MODEL_DIR=./storage/models/whisper-base
ASR_LANGUAGE=zh
ASR_DEVICE=cpu
ASR_CHUNK_SECONDS=30
ASR_OVERLAP_SECONDS=2
FUNASR_VAD_DIR=
FUNASR_PUNC_DIR=
FUNASR_SPEAKER_DIR=
TTS_PROVIDER=local
TTS_MODEL_DIR=./storage/models/vits-piper-vi_VN-vais1000-medium
DUB_TIMEOUT_SECONDS=1800
DUB_MAX_SEGMENTS=300
SYNC_MIN_FACTOR=0.85
SYNC_MAX_FACTOR=1.2
# M4: local FFmpeg/libass final render; no external uploads.
FINAL_TIMEOUT_SECONDS=1800
FINAL_PREVIEW_MAX_SECONDS=15
FINAL_PREVIEW_CACHE_ENTRIES=5
FINAL_MAX_PIXELS=8294400
# Optional Azure cloud TTS: requires explicit UI text-transmission confirmation.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AUTO_REVIEW_ENABLED=true
AUTO_REVIEW_OCR_HIGH_THRESHOLD=0.95
AUTO_REVIEW_OCR_LOW_THRESHOLD=0.80
AUTO_REVIEW_MAX_BATCH_SIZE=100
AUTO_REVIEW_REQUIRE_TRANSLATION_CHECK=true
